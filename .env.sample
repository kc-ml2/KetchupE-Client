# .env.sample — 선택적 서비스/독립 진단 도구 설정. 필요한 항목만 .env로 복사하세요.
# 앱 모델 선택은 llm.config.yaml, LiteLLM/MARU 주소·키는 이메일 인증 broker가 관리합니다.
# 기존 .env의 LITELLM_ROUTER_MODEL_ALIAS는 제거하세요. 앱에서는 사용하지 않습니다.
# .env는 .gitignore에 이미 포함되어 있어 커밋되지 않습니다.
# 서비스 수집 설정은 공식 빌드에 포함되며 앱 화면에서 사용자가 변경하지 않습니다.

# ── LiteLLM (모델 gateway) ──────────────────────────────────────────
# 독립 smoke:litellm 스크립트 전용. 앱은 이메일 인증으로 발급받은 사용자 키를 사용합니다.
LITELLM_API_KEY=
# 선택: 기본값은 electron/agent/modelClient.ts의 DEFAULT_LITELLM_BASE_URL (centinels.ml2-alpha.com)
LITELLM_BASE_URL=
# 독립 smoke 스크립트용 모델. 앱의 모델은 llm.config.yaml에서 선택합니다.
LITELLM_MODEL_ALIAS=
# 앱의 주소·키는 로그인 broker만 사용합니다. 역할별 API 환경변수는 지원하지 않습니다.

# ── 중앙 OTLP 수집 (공식 빌드에서 서비스 관리자가 강제) ───────────────
# 데스크톱에는 Langfuse secret을 넣지 않습니다. 비우면 로컬 개발에서만 전송이 꺼집니다.
KETCHUPE_OTLP_ENDPOINT=https://telemetry.example.com/v1/traces
KETCHUPE_OTLP_TOKEN=
# ops | redacted_eval | internal_full
KETCHUPE_TELEMETRY_CONTENT_MODE=ops
KETCHUPE_ENVIRONMENT=development
KETCHUPE_TENANT_ID=public
# 선택: policy A/B variant 강제 지정 (always-search-v1 | adaptive-v1 | gated-v1). 비우면 install id 기준 결정적 자동 배정.
KETCHUPE_VARIANT=

# telemetry gateway 프로세스에만 설정합니다. 데스크톱 빌드에 포함하지 않습니다.
# 셀프호스팅이면 그 주소(예: http://localhost:3000)와 해당 프로젝트 키로 바꿉니다. Langfuse v4 필요.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
KETCHUPE_INGEST_TOKEN=

# ── Tomato (로컬 검색 엔진) ───────────────────────────────────────────
# 선택: multilingual-e5-small 임베딩 가중치 캐시 경로. 비우면 <home>/models.
TOMATO_MODEL_CACHE=

# Notion 동기화는 GitHub Actions secrets에서 관리합니다 (notion-fcn-sync.yml).
# 기존 VITE_API_URL / NOTION_SCN_DATABASE_ID는 현재 앱에서 사용하지 않습니다.

# ── MARU MCP ─────────────────────────────────────────────────────────
# onboarding: https://maru.ml2-alpha.com/onboarding.md
# 독립 진단 도구를 사용할 때만 입력합니다 (Bearer 접두어 없이). 앱 로그인에는 사용하지 않습니다.
MARU_API_TOKEN=
# 독립 probe:maru 스크립트 전용. 앱은 broker가 반환한 주소와 키를 사용합니다.
MARU_MCP_ENDPOINT=https://maru.ml2-alpha.com/mcp

# ── Trolley MCP ──────────────────────────────────────────────────────
# 키는 로컬 .env에 직접 입력합니다 (Bearer 접두어 없이). 채팅에 보내지 마세요.
TROLLEY_API_KEY=
TROLLEY_MCP_ENDPOINT=https://trolley.ml2-alpha.com/mcp/

# ── 일일자금일보 출력 ───────────────────────────────────────────────
# Excel 재계산/출력 실패 시 로컬 LibreOffice로 자동 전환합니다. 별도 설치가 필요합니다.
# 선택: 기본 설치 경로/PATH에서 찾지 못할 때 soffice 실행 파일의 절대 경로.
# KETCHUPE_LIBREOFFICE_PATH=
